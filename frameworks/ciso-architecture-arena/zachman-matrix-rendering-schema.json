{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alex-cyber-study.local/frameworks/ciso-architecture-arena/zachman-matrix-rendering-schema.json",
  "title": "Zachman Matrix Rendering Schema",
  "description": "Rendering contract for a clickable Zachman 6x6 matrix.",
  "type": "object",
  "required": [
    "component",
    "version",
    "clickBehavior",
    "layout",
    "accessibility",
    "binding"
  ],
  "additionalProperties": false,
  "properties": {
    "component": {
      "type": "string",
      "const": "ZachmanMatrixGrid"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "clickBehavior": {
      "type": "object",
      "required": ["type", "eventName", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["emit-event"] },
        "eventName": { "type": "string", "minLength": 3 },
        "payload": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string" }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["header", "rowLabels", "cellSize", "responsiveBreakpointPx"],
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "object",
          "required": ["sticky"],
          "additionalProperties": false,
          "properties": { "sticky": { "type": "boolean" } }
        },
        "rowLabels": {
          "type": "object",
          "required": ["sticky"],
          "additionalProperties": false,
          "properties": { "sticky": { "type": "boolean" } }
        },
        "cellSize": {
          "type": "string",
          "enum": ["compact", "comfortable"]
        },
        "responsiveBreakpointPx": {
          "type": "integer",
          "minimum": 320
        }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["role", "keyboardNavigation", "ariaCellPattern"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "const": "grid" },
        "keyboardNavigation": { "type": "boolean" },
        "ariaCellPattern": { "type": "string", "minLength": 8 }
      }
    },
    "binding": {
      "type": "object",
      "required": ["rowsPath", "columnsPath", "cellsPath", "cellKey"],
      "additionalProperties": false,
      "properties": {
        "rowsPath": { "type": "string", "const": "$.matrix.rows" },
        "columnsPath": { "type": "string", "const": "$.matrix.columns" },
        "cellsPath": { "type": "string", "const": "$.matrix.cells" },
        "cellKey": { "type": "string", "const": "id" }
      }
    }
  }
}
